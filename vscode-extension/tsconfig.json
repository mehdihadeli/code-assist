{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "verbatimModuleSyntax": false,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node", "vscode"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}